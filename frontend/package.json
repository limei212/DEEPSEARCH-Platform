{
  "name": "deepsearch-agents-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev:compat": "node --require ./esbuild-compat.cjs node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173 --strictPort",
    "build:compat": "tsc -b && node --require ./esbuild-compat.cjs node_modules/vite/bin/vite.js build",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@tailwindcss/vite": "^4.1.0",
    "antd": "^5.26.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild-wasm": "0.27.7",
    "typescript": "^5.8.0",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@10.33.0"
}
